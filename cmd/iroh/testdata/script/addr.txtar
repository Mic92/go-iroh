# Transport address parsing round-trips the canonical "kind:value" form.

iroh addr parse ip:127.0.0.1:1234
stdout '^ip:127.0.0.1:1234$'

iroh addr parse relay:https://relay.example.com
stdout '^relay:https://relay.example.com/$'

iroh addr parse custom:2a_abab
stdout '^custom:2a_abab$'

# Unknown kinds are rejected.
! iroh addr parse bogus:value
